<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">	  
    <body>
        <referenceBlock name="product_list_toolbar">
            <action method="setDefaultDirection">
                <argument name="dir" xsi:type="string">desc</argument>
            </action>
        </referenceBlock>
		<referenceContainer name="columns" htmlClass="columns">
            <block class="Magento\Framework\View\Element\Template" name="custom-result-list-product-columns" template="Magento_CatalogSearch::result/result_list-columns.phtml" />
        </referenceContainer>
        <move element="div.sidebar.main" destination="custom-result-list-product-columns" before="main" />
        <move element="main" destination="custom-result-list-product-columns"/>
        <move element="div.sidebar.additional" destination="custom-result-list-product-columns" after="main" />
        <move element="category.description" destination="page.bottom" />
        <!-- <move element="page.main.title" destination="product_list_toolbar" before="-" /> -->
	</body>
</page>