declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsSolid;
use Magento\Framework\View\Element\Template;
use Magento\Framework\Escaper;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var HeroiconsSolid $heroiconsSolid */
$heroiconsSolid = $viewModels->require(HeroiconsSolid::class);

/** @var string[] $menu */
$item = $block->getData('item');
$level = $block->getData('level');
$menuId = str_replace('-', '_',$item['id']);
$mediaUrl = $block->getUrl(\Magento\Framework\UrlInterface::URL_TYPE_MEDIA);
?>
<?php if ($level == 1): ?>
    <?php if (!empty($item['childData'])): ?>
        <li
            class="level-<?= $level ?>"
            data-id="<?= /* @noEscape */$menuId ?>"
            x-data="initSubMenuDesktopItem"
            @click.outside="close"
            @keydown.escape="close"
            @mouseenter="canHoverOpen"
            @mouseleave="canHoverClose"
        >
            <button
                type="button"
                class="group w-full flex justify-between items-center gap-1 p-2 hover:bg-slate-50
                    aria-expanded:text-blue-800 aria-expanded:bg-blue-50 data-[has-current]:font-medium"
                x-ref="childmenuToggle"
                @click="toggle"
                aria-expanded="false"
                :aria-expanded="open"
                aria-controls="<?= $escaper->escapeHtml($item['id']) ?>-desktop-menu-panel"
            >
                <a
                    href="<?= $escaper->escapeUrl($item['url']) ?>"
                    title="<?= $escaper->escapeHtmlAttr($item['name']) ?>"
                    class="w-full flex justify-between items-center color-title"
                >
                    <?= $escaper->escapeHtml($item['name']) ?>
                    <?= $heroiconsSolid->chevronRightHtml(
                        'text-slate-400 group-aria-expanded:text-inherit',
                        24,
                        24,
                        ['aria-hidden' => 'true'])
                    ?>
                </a>
            </button>
            <ul
                id="<?= $escaper->escapeHtml($item['id']) ?>-desktop-menu-panel"
                class="absolute inset-0 border-l border-slate-100 bg-white flex flex-col gap-1 py-2.5 px-2 translate-x-72"
                x-show="open"
                x-ref="childmenuWrapper"
                @keydown.escape.stop="close"
            >
                <?php foreach ($item['childData'] as $subMenu): ?>

                    <?= $block->getLayout()->getBlock('topmenu_desktop_item')
                        ->setItem($subMenu)
                        ->setLevel($level + 1)
                        ->toHtml() ?>
                <?php endforeach; ?>
            </ul>
        </li>
    <?php else: ?>
        <li class="level-<?= $level ?>">
            <a
                href="<?= $escaper->escapeUrl($item['url']) ?>"
                class="level-<?= $level ?> flex p-2 hover:bg-slate-50 aria-[current=page]:font-medium"
            ><?= $escaper->escapeHtml($item['name']) ?></a>
        </li>
    <?php endif; ?>
<?php else: ?>
    <?php if (!empty($item['childData'])): ?>
        <li class="break-inside-avoid pb-4">
            <?php if ($item['menuthumbnail']): ?>
                <img src="<?= $item['menuthumbnail'] ?>"
                    alt="<?= $escaper->escapeHtmlAttr($item['name']) ?>"
                    title="<?= $escaper->escapeHtmlAttr($item['name']) ?>"
                    width="80"
                    height="80" />
            <?php else: ?>
                <img src="<?= $mediaUrl."" ?>"
                    alt="<?= $escaper->escapeHtmlAttr($item['name']) ?>"
                    title="<?= $escaper->escapeHtmlAttr($item['name']) ?>"
                    width="80"
                    height="80" />
            <?php endif; ?>
            <a
                href="<?= $escaper->escapeUrl($item['url']) ?>"
                class="level-<?= $level ?> block py-1 font-medium hover:underline aria-[current=page]:underline"
            ><?= $escaper->escapeHtml($item['name']) ?></a>
            <ul class="columns-xs gap-8">
                <?php foreach ($item['childData'] as $subMenu): ?>
                    <li class="break-inside-avoid pb-4">
                        <a
                            href="<?= $escaper->escapeUrl($subMenu['url']) ?>"
                            class="level-<?= $level ?> block py-1 font-medium hover:underline aria-[current=page]:underline"
                        ><?= $escaper->escapeHtml($subMenu['name']) ?></a>
                        <?php if (!empty($subMenu['childData'])): ?>
                            <ul>
                                <?php foreach ($subMenu['childData'] as $subMenuItems): ?>
                                    <li>
                                        <a
                                            href="<?= $escaper->escapeUrl($subMenuItems['url']) ?>"
                                            class="level-<?= $level ?> block py-1 hover:underline aria-[current=page]:underline"
                                        ><?= $escaper->escapeHtml($subMenuItems['name']) ?></a>
                                    </li>
                                <?php endforeach; ?>
                            </ul>
                        <?php endif; ?>
                    </li>
                <?php endforeach; ?>
            </ul>
        </li>
    <?php else: ?>
        <li>
            <?php if (isset($item['menuthumbnail']) && $item['menuthumbnail']): ?>
                <img src="<?= $item['menuthumbnail'] ?>"
                    alt="<?= $escaper->escapeHtmlAttr($item['name']) ?>"
                    title="<?= $escaper->escapeHtmlAttr($item['name']) ?>"
                    width="80"
                    height="80" />
            <?php else: ?>
                <img src="<?= $mediaUrl."" ?>"
                    alt="<?= $escaper->escapeHtmlAttr($item['name']) ?>"
                    title="<?= $escaper->escapeHtmlAttr($item['name']) ?>"
                    width="80"
                    height="80" />
            <?php endif; ?>
            <a
                href="<?= $escaper->escapeUrl($item['url']) ?>"
                title="<?= $escaper->escapeHtmlAttr($item['name']) ?>"
                class="level-<?= $level ?> block py-1 font-medium hover:underline aria-[current=page]:underline"
            >
                <?= $escaper->escapeHtml($item['name']) ?>
            </a>
        </li>
    <?php endif; ?>
<?php endif; ?>
