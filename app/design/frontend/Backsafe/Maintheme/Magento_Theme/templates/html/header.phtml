<script>
    function initHeader() {
        return {
            searchOpen: false, // Start with search hidden on mobile
            cart: {},
            isCartOpen: false,
            getData(data) {
                if (data.cart) {
                    this.cart = data.cart
                }
            },
            isCartEmpty() {
                return !this.cart.summary_count
            },
            cartLabel() {
                var label = "Quote Cart: 0";
                if (this.cart.summary_count) {
                    label = "Quote Cart: " + this.cart.summary_count;
                }
                console.log(label);
                return label;
            },
            toggleCart(event) {
                if (event.detail && event.detail.isOpen !== undefined) {
                    this.isCartOpen = event.detail.isOpen
                    if (!this.isCartOpen && this.$refs && this.$refs.cartButton) {
                        this.$refs.cartButton.focus()
                    }
                } else {
                    <?php
                    /*
                     * The toggle-cart event was previously dispatched without parameter to open the drawer (not toggle).
                     * Keeping this in here for backwards compatibility.
                     */
                    ?>
                    this.isCartOpen = true
                }
            },
            /**
             * Toggle search visibility on mobile
             * On desktop, search is always visible
             */
            toggleSearch() {
                if (window.innerWidth < 768) {
                    this.searchOpen = !this.searchOpen;
                    
                    if (this.searchOpen) {
                        this.$nextTick(() => {
                            // Focus on search input when opened
                            const searchInput = document.querySelector('#search');
                            if (searchInput) {
                                searchInput.focus();
                            }
                        });
                    }
                }
            },
            /**
             * Initialize search visibility based on screen size
             * Desktop: Always visible
             * Mobile: Hidden by default, toggle with icon
             */
            init() {
                // Set initial state based on viewport width
                this.searchOpen = window.innerWidth >= 768;

                // Handle window resize
                window.addEventListener('resize', () => {
                    if (window.innerWidth >= 768) {
                        // Desktop: Always show search
                        this.searchOpen = true;
                    }
                    // On mobile, maintain current toggle state
                });

                // Close search when clicking outside on mobile
                document.addEventListener('click', (e) => {
                    if (window.innerWidth < 768 && this.searchOpen) {
                        const searchContent = document.getElementById('search-content');
                        const searchIcon = document.getElementById('menu-search-icon');
                        
                        if (searchContent && searchIcon && 
                            !searchContent.contains(e.target) && 
                            !searchIcon.contains(e.target)) {
                            this.searchOpen = false;
                        }
                    }
                });
            }
        }
    }

    function initCompareHeader() {
        return {
            compareProducts: null,
            itemCount: 0,
            receiveCompareData(data) {
                if (data['compare-products']) {
                    this.compareProducts = data['compare-products'];
                    this.itemCount = this.compareProducts.count;
                }
            }
        }
    }
</script>
