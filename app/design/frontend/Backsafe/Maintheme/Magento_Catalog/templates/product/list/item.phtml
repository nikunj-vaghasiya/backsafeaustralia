<?php else: ?>
    </div>
<?php endif; ?>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('productEnquiryHome', () => ({
            async GetQuoteHome(event) {
                // Find the closest product form/container
                const productForm = event.target.closest('.product_addtocart_form') || event.target.closest('.product-item');
                
                // Find the quantity input within this specific product
                const quantityInput = productForm.querySelector('.enquirytxt');
                
                if (!quantityInput) {
                    console.error('Quantity input not found for this product');
                    return;
                }

                const prodId = quantityInput.dataset.id;
                const prodQty = quantityInput.value;
                const parentId = quantityInput.dataset.parentid;
                const name = quantityInput.dataset.name?.split(",").join("");
                const parentUrl = quantityInput.dataset.parenturl;
                const sku = quantityInput.dataset.sku;

                const validationBox = document.getElementById('validation-enquiry-box');
                
                if (prodQty <= 0) {
                    if (validationBox) {
                        validationBox.style.display = 'block';
                    }
                    return;
                }

                if (validationBox) {
                    validationBox.style.display = 'none';
                }

                const postUrl = "<?= $escaper->escapeUrl($block->getUrl('productenquiry/index/add')) ?>";
                const formKey = hyva.getFormKey();
                const uenc = btoa(window.location.href);

                // Create product string for only the clicked product
                const productData = `${prodId}=>${parentId}=>${prodQty}=>${name}=>${parentUrl}=>${sku}`;

                const data = new URLSearchParams({
                    form_key: formKey,
                    products: productData, // Only single product
                    uenc: uenc,
                });

                try {
                    const response = await fetch(postUrl, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
                        },
                        body: data,
                        credentials: "include",
                    });

                    const responseText = await response.text();

                    try {
                        const jsonData = JSON.parse(responseText);
                        
                        if (jsonData !== 'error') {
                            window.location.href = jsonData;
                        } else if (response.ok) {
                            return response.json();
                        }
                    } catch (jsonError) {
                        console.error("Invalid JSON", jsonError);
                    }

                } catch (error) {
                    alert(error.message);
                }
            }
        }));
    });
</script>