<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
      <referenceBlock name="description" remove="true"/>
      <referenceBlock name="product.section.title.renderer" remove="true"/>
      <move element="product.info.details" destination="product.info" after="-"/>      
      <referenceBlock name="product.info">
        <block class="Magento\Catalog\Block\Product\View" name="select.option.button" template="Magento_Catalog::product/view/select-option.phtml"/>
      </referenceBlock>
      <referenceBlock name="product.detail.page">
        <block class="Magento\Catalog\Block\Product\View" name="content-with-video" template="Magento_Catalog::product/view/content-with-video.phtml"/>
      </referenceBlock>
      <referenceBlock name="product.info.details">
        <block class="Magento\Catalog\Block\Product\View" name="custom.button" template="Magento_Catalog::product/view/select-option.phtml"/>
        <block class="Digital\Base\Block\Product\Tabs"
               name="product.tabs"
               template="Magento_Catalog::product/view/tabs.phtml"
               group="detailed_info"
               before="-">
            <arguments>
                <argument name="sort_order" xsi:type="number">10</argument> 
            </arguments>
        </block>
      </referenceBlock>
      <referenceBlock name="product.info.main">
          <block class="Magento\Catalog\Block\Product\View" name="product-enquiry" template="Magento_Catalog::product/product-enquiry.phtml" after="-"/>
      </referenceBlock>
    </body>
</page>  