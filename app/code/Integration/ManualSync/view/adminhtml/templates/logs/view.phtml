							<?php endforeach; ?>
						<?php endif; ?>
					</select>
				</td>
				<td><a href="<?php echo $this->getBackUrl($storeId); ?>" title="<?php echo __('Back'); ?>" class="sync-black-btn"><?php echo __('Back'); ?></a></td>
			</tr>
		</tbody>
	</table>
	<table class="products-table">
		<thead>
			<tr>
				<th class="col number"><?php echo __('No.');?></th>
				<th class="col name"><?php echo __('Log File Name');?></th>
				<th class="col description"><?php echo __('Description');?></th>
				<th class="col action"><?php echo __('Action');?></th>
			</tr>
		</thead>
		<?php if(count($logFiles) > 0): ?>
			<tbody>
				<?php $i = 1; foreach($logFiles as $logFilePath): ?>
					<?php $fileName = explode("/", $logFilePath, 4);?>
					<?php $fileName = $fileName[3];?>
					<?php $description = $this->getLogDescriptionByFileName($fileName); ?>
					<?php $fileName = basename($logFilePath);?>
					<tr>
						<td class="number"><?php echo __($i); ?></td>
						<td class="name"><?php echo __($fileName); ?></td>
						<td class="description"><?php echo $description; ?></td>
						<td class="action">
							<a href="<?php echo $this->getDownloadUrl($type,$storeId,$this->getRequestedDate(),pathinfo($logFilePath,PATHINFO_FILENAME)); ?>" title="<?php echo __('Download'); ?>" download="<?php echo $fileName; ?>"><?php echo __('Download'); ?></a>
						</td>
					</tr>
				<?php $i++; endforeach; ?>
