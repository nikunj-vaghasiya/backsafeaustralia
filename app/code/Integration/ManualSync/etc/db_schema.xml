<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="integration_product" resource="default" engine="innodb" comment="Integration Product Table">
        
        <!-- Primary Key -->
        <column xsi:type="int" name="api_entity_id" unsigned="true" nullable="false" identity="true" comment="Entity Id"/>
        
        <!-- Product Basic Info -->
        <column xsi:type="varchar" name="sku" nullable="true" length="65" comment="SKU"/>
        <column xsi:type="smallint" name="status" unsigned="false" nullable="true" comment="Status, 1 = Enable, 2 = Disable"/>
        <column xsi:type="varchar" name="name" nullable="true" length="255" comment="Product Name"/>
        
        <!-- Pricing -->
        <column xsi:type="decimal" name="price" scale="4" precision="12" unsigned="false" nullable="true" comment="Price"/>
        
        
        <!-- Inventory -->
        <column xsi:type="varchar" name="quantity" nullable="true" length="255" comment="QTY"/>
        <column xsi:type="varchar" name="stock_status" nullable="true" length="255" comment="Stock Status"/>
        
        <!-- Dimensions - REMOVED: height and length -->
        
        <column xsi:type="varchar" name="weight" nullable="true" length="255" comment="Weight"/>
        
        
        <!-- NEW COLUMNS: Description and Supplier -->
        <column xsi:type="text" name="description" nullable="true" comment="Product Description"/>
        <column xsi:type="varchar" name="supplier" nullable="true" length="255" comment="Supplier Name"/>
        
        <!-- Additional Info -->
        
        <column xsi:type="smallint" name="website_id" unsigned="false" nullable="true" comment="Website Id"/>
        <column xsi:type="int" name="new_flag" unsigned="false" nullable="true" comment="1 => New, 0 => Updated"/>
        
        <!-- Timestamps -->
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At (Current Server Time)"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At (Current Server Time)"/>
        
        <!-- Primary Key Constraint -->
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="api_entity_id"/>
        </constraint>
        
        <!-- Index on SKU for faster lookups -->
        <index referenceId="INTEGRATION_PRODUCT_SKU" indexType="btree">
            <column name="sku"/>
        </index>
        
        <!-- Optional: Index on status for filtering -->
        <index referenceId="INTEGRATION_PRODUCT_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>
</schema>