<?php
/**
 * Quote Success Template
 * 
 * This template displays the success message after a quote inquiry is submitted.
 * It includes validation to ensure the user actually submitted a quote inquiry.
 */

$quoteSaveId = $block->getQuoteSaveId() ?? null;
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$session = $objectManager->get('Magento\Framework\Session\SessionManagerInterface');

// Double-check quote_save_id
if (empty($quoteSaveId)) {
    $quoteSaveId = $session->getQuoteSaveId();
}

// If still empty after both checks, show error and redirect
if (empty($quoteSaveId) || is_null($quoteSaveId) || $quoteSaveId <= 0) {
    echo '<div class="container"><div class="alert alert-danger" style="margin-top: 20px;">';
    echo '<strong>Error:</strong> ';
    echo __('Invalid request. Please submit a quote inquiry to access this page.');
    echo '</div>';
    echo '<p><a href="' . $block->getBaseUrl() . '" class="btn btn-primary">Back to Home</a></p>';
    echo '</div>';
    
    // Clear session
    $session->unsQuote();
    $session->unsQuoteSaveId();
    return;
}
