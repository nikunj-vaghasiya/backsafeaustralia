<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="admin-2columns-left" xsi:noNamespaceSchemaLocation="../../../../../../../lib/internal/Magento/Framework/View/Layout/etc/page_configuration.xsd">
    
    <update handle="editor"/>
    <body>
        <referenceContainer name="content">
            <block class="Digital\Productenquiry\Block\Adminhtml\Productenquiry\Edit" name="productenquiry_index_edit"/>
            <block class="Magento\Framework\View\Element\Template" name="digital.productenquiry.list" template="Digital_Productenquiry::pdfimageicon.phtml" />
        </referenceContainer>
        <referenceContainer name="left">
            <block class="Digital\Productenquiry\Block\Adminhtml\Productenquiry\Edit\Tabs" name="productenquiry_edit_tabs">
                <block class="Digital\Productenquiry\Block\Adminhtml\Productenquiry\Edit\Tab\Main" name="productenquiry_edit_tab_main"/>
                <action method="addTab">
                    <argument name="name" xsi:type="string">main_section</argument>
                    <argument name="block" xsi:type="string">productenquiry_edit_tab_main</argument>
                </action>
            </block>
        </referenceContainer>
    </body>
</page>
