<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

	<type name="Digital\Productenquiry\Controller\Adminhtml\Index\GridToCsv">
    	<arguments>
        	<argument name="converter" xsi:type="object">Digital\Productenquiry\Model\Export\ConvertToCsv</argument>
    	</arguments>
	</type>
	              
    <virtualType name="ProductenquiryGridDataProvider" type="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
        <arguments>
            <argument name="collection" xsi:type="object" shared="false">Digital\Productenquiry\Model\ResourceModel\Productenquiry\Collection</argument>
            <argument name="filterPool" xsi:type="object" shared="false">ProductenquiryGridFilterPool</argument>
        </arguments>
    </virtualType>

    <virtualType name="ProductenquiryGridFilterPool" type="Magento\Framework\View\Element\UiComponent\DataProvider\FilterPool">
        <arguments>
            <argument name="appliers" xsi:type="array">
                <item name="regular" xsi:type="object">Magento\Framework\View\Element\UiComponent\DataProvider\RegularFilter</item>
                <item name="fulltext" xsi:type="object">Magento\Framework\View\Element\UiComponent\DataProvider\FulltextFilter</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="digital_productenquiry_listing_data_source" xsi:type="string">Digital\Productenquiry\Model\ResourceModel\Productenquiry\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

    <virtualType name="Digital\Productenquiry\Model\ResourceModel\Productenquiry\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">digital_product_enquiry</argument>
            <argument name="resourceModel" xsi:type="string">Digital\Productenquiry\Model\ResourceModel\Productenquiry</argument>
        </arguments>
    </virtualType>

    
</config>