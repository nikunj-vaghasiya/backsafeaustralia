<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">digital_cmsbanner_form.digital_cmsbanner_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Banner Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>

    <settings>
        <buttons>
            <button name="back">
                <url path="*/*/"/>
                <class>back</class>
                <label translate="true">Back</label>
            </button>
            <button name="delete" class="Digital\Cmsbanner\Block\Adminhtml\Banner\Edit\DeleteButton"/>
            <button name="reset" class="Digital\Cmsbanner\Block\Adminhtml\Banner\Edit\ResetButton"/>
            <button name="save_and_continue" class="Digital\Cmsbanner\Block\Adminhtml\Banner\Edit\SaveAndContinueButton"/>
            <button name="save" class="Digital\Cmsbanner\Block\Adminhtml\Banner\Edit\SaveButton"/>
        </buttons>
        <namespace>digital_cmsbanner_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>digital_cmsbanner_form.digital_cmsbanner_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="digital_cmsbanner_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="cmsbanner/banner/save"/>
        </settings>
        <aclResource>Digital_Cmsbanner::banner_save</aclResource>
        <dataProvider class="Digital\Cmsbanner\Model\Banner\DataProvider"
                      name="digital_cmsbanner_form_data_source">
            <settings>
                <requestFieldName>banner_id</requestFieldName>
                <primaryFieldName>banner_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">General Information</label>
            <collapsible>false</collapsible>
        </settings>

        <field name="banner_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>

        <field name="status" sortOrder="10" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">digital_cmsbanner</item>
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">false</rule>
                </validation>
                <dataType>boolean</dataType>
                <label translate="true">Enable</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>

        <field name="name" sortOrder="20" formElement="input">
            <settings>
                <label translate="true">Banner Name</label>
                <dataType>text</dataType>
                <dataScope>name</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="link" sortOrder="30" formElement="input">
            <settings>
                <label translate="true">Link (URL)</label>
                <dataType>text</dataType>
                <dataScope>link</dataScope>
                <notice>For external linking please add link with "http", for internal linking simple add after Base URL link for example "example.html".</notice>
            </settings>
        </field>

        <field name="sort_order" sortOrder="40" formElement="input">
            <settings>
                <label translate="true">Sort Order</label>
                <dataType>number</dataType>
                <dataScope>sort_order</dataScope>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="cms_pages" sortOrder="50" formElement="multiselect">
            <settings>
                <label translate="true">CMS Pages</label>
                <dataType>text</dataType>
                <dataScope>cms_pages</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Digital\Cmsbanner\Model\Banner\Source\CmsPages"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>

        <field name="image" sortOrder="60" formElement="imageUploader">
            <settings>
                <elementTmpl>ui/form/element/uploader/image</elementTmpl>
                <notice translate="true">Image Dimension : W1920px * H512px</notice>
                <dataType>string</dataType>
                <label translate="true">Desktop Banner Image</label>
                <visible>true</visible>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <uploaderConfig>
                            <param xsi:type="url" name="url" path="cmsbanner/banner/upload"/>
                        </uploaderConfig>
                        <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                        <openDialogTitle>Media Gallery</openDialogTitle>
                        <initialMediaGalleryOpenSubpath>digital/cmsbanner</initialMediaGalleryOpenSubpath>
                        <allowedExtensions>jpg jpeg png</allowedExtensions>
                        <maxFileSize>4194304</maxFileSize>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
        <field name="mobile_image" sortOrder="70" formElement="imageUploader">
            <settings>
                <elementTmpl>ui/form/element/uploader/image</elementTmpl>
                <notice translate="true">Image Dimension : W375px * H100px</notice>
                <dataType>string</dataType>
                <label translate="true">Mobile Banner Image</label>
                <visible>true</visible>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <uploaderConfig>
                            <param xsi:type="url" name="url" path="cmsbanner/banner/upload"/>
                        </uploaderConfig>
                        <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                        <openDialogTitle>Media Gallery</openDialogTitle>
                        <initialMediaGalleryOpenSubpath>digital/cmsbanner</initialMediaGalleryOpenSubpath>
                        <allowedExtensions>jpg jpeg png</allowedExtensions>
                        <maxFileSize>4194304</maxFileSize>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
    </fieldset>
</form>
