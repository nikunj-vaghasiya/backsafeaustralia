<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Model interfaces -->
    <preference for="Digital\Cmsbanner\Api\Data\BannerInterface" type="Digital\Cmsbanner\Model\Banner"/>
    <preference for="Digital\Cmsbanner\Api\BannerRepositoryInterface" type="Digital\Cmsbanner\Model\BannerRepository"/>

    <!-- Virtual type for grid collection -->
    <virtualType name="Digital\Cmsbanner\Model\ResourceModel\Banner\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">digital_cmsbanner</argument>
            <argument name="resourceModel" xsi:type="string">Digital\Cmsbanner\Model\ResourceModel\Banner</argument>
        </arguments>
    </virtualType>

    <!-- Data provider for UI component -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="digital_cmsbanner_listing_data_source" xsi:type="string">
                    Digital\Cmsbanner\Model\ResourceModel\Banner\Grid\Collection
                </item>
            </argument>
        </arguments>
    </type>

    <!-- Image uploader -->
    <!-- <type name="Digital\Cmsbanner\Controller\Adminhtml\Banner\Upload">
        <arguments>
            <argument name="imageUploader" xsi:type="object">Digital\Cmsbanner\Model\ImageUploader</argument>
        </arguments>
    </type> -->

    <virtualType name="Digital\Cmsbanner\Model\BannerImageUploader"
             type="Magento\Catalog\Model\ImageUploader">
        <arguments>
            <argument name="baseTmpPath" xsi:type="string">digital/cmsbanner/tmp</argument>
            <argument name="basePath" xsi:type="string">digital/cmsbanner</argument>
            <argument name="allowedExtensions" xsi:type="array">
                <item name="jpg" xsi:type="string">jpg</item>
                <item name="jpeg" xsi:type="string">jpeg</item>
                <item name="png" xsi:type="string">png</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Digital\Cmsbanner\Controller\Adminhtml\Banner\Upload">
        <arguments>
            <argument name="imageUploader" xsi:type="object">
                Digital\Cmsbanner\Model\BannerImageUploader
            </argument>
        </arguments>
    </type>

    <type name="Digital\Cmsbanner\Model\Banner\DataProvider">
        <arguments>
            <argument name="imageUploader" xsi:type="object">Digital\Cmsbanner\Model\BannerImageUploader</argument>
        </arguments>
    </type>
</config>
