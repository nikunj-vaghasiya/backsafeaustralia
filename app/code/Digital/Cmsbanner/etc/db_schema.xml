<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="digital_cmsbanner" resource="default" engine="innodb" comment="Digital CMS Banner Table">
        <column xsi:type="int" name="banner_id" unsigned="true" nullable="false" identity="true" comment="Banner ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Banner Name"/>
        <column xsi:type="varchar" name="link" nullable="true" length="255" comment="Banner Link"/>
        <column xsi:type="smallint" name="status" nullable="false" default="1" comment="Status (1=Enabled, 0=Disabled)"/>
        <column xsi:type="int" name="sort_order" nullable="false" default="0" comment="Sort Order"/>
        <column xsi:type="varchar" name="image" nullable="true" length="255" comment="Desktop Banner Image"/>
        <column xsi:type="varchar" name="mobile_image" nullable="true" length="255" comment="Mobile Banner Image"/>
        <column xsi:type="text" name="cms_pages" nullable="true" comment="CMS Pages (comma-separated identifiers)"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="banner_id"/>
        </constraint>
        <index referenceId="DIGITAL_CMSBANNER_STATUS" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="DIGITAL_CMSBANNER_SORT_ORDER" indexType="btree">
            <column name="sort_order"/>
        </index>
    </table>
</schema>
