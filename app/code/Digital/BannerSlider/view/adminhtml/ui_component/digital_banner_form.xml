<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">digital_banner_form.digital_banner_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Banner Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
        <item name="reverseMetadataMerge" xsi:type="boolean">true</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Digital\BannerSlider\Block\Adminhtml\Edit\Button\Back"/>
            <button name="save" class="Digital\BannerSlider\Block\Adminhtml\Edit\Button\Save"/>
            <button name="delete" class="Digital\BannerSlider\Block\Adminhtml\Edit\Button\Delete"/>
            <button name="save_and_continue" class="Digital\BannerSlider\Block\Adminhtml\Edit\Button\SaveAndContinue"/>
        </buttons>
        <namespace>digital_banner_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>digital_banner_form.digital_banner_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="digital_banner_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <validateUrl path="bannerslider/banner/validate"/>
            <submitUrl path="bannerslider/banner/save"/>
        </settings>
        <dataProvider class="Digital\BannerSlider\Model\Banner\DataProvider" name="digital_banner_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>banner_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general" sortOrder="5">
        <settings>
            <collapsible>false</collapsible>
            <label/>
        </settings>
        <field name="id" formElement="hidden">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">digital_banner</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
            </settings>
        </field>
        <field name="status" sortOrder="10" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">digital_banner</item>
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">false</rule>
                </validation>
                <dataType>boolean</dataType>
                <label translate="true">Enable</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="name" sortOrder="20" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>string</dataType>
                <label translate="true">Name</label>
            </settings>
        </field>
       
        <field name="banner_url" sortOrder="30" formElement="input">
            <settings>
                <dataType>string</dataType>
                <label translate="true">Url</label>
                <notice>For external linking please add link with "http", for internal linking simple add after Base URL link for example "example.html".</notice>
            </settings>
        </field>
        <field name="description" sortOrder="40" formElement="textarea">
            <settings>
                <dataType>string</dataType>
                <label translate="true">Description</label>
                <validation>
                    <rule name="max_text_length" xsi:type="number">200</rule>
                </validation>
                <notice>Please add upto maximum 200 characters</notice>
            </settings>
        </field>
         <field name="title" sortOrder="50" formElement="input">
            <settings>
                <dataType>string</dataType>
                <label translate="true">Button Title</label>
            </settings>
        </field>
