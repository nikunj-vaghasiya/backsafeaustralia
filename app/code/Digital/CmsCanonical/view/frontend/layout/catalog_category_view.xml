<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
	<body>
        <referenceBlock name="head.additional">
            <container name="canonical.url.custom.page.container">
                <block class="Magento\Framework\View\Element\Text" name="canonical.url.custom.page">
                    <arguments>
                        <argument name="label" xsi:type="string">Adding canonical link with base URL</argument>
                        <argument name="text" xsi:type="helper" helper="Digital\CmsCanonical\Helper\Canonical::getCanonicalForCustomModules"/>
                    </arguments>
                </block>
            </container>
        </referenceBlock>
    </body>
</page>