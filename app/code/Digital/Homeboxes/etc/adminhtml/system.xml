<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../Config/etc/system_file.xsd">
<system>
	<section id="homeboxes_section" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
		<label>Homeboxes</label>
		<tab>digital</tab>
		<!-- resource tag name which we have to defined in the acl.xml -->
		<resource>Digital_Homeboxes::settings</resource>
		<group id="general" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
			<label>Configuration</label>
			<field id="enable" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
				<label>Enable</label>
				<source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
			</field>
			<!-- <field id="title" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
	            <label>Title</label>
	            <comment>Entered title visible on frontend section, if empty then title removed from frontend.</comment>
	        </field> -->
	        <field id="box_limit" translate="label" type="text" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
	            <label>Boxes Limit</label>
	            <comment>Enter The limit of boxes to display on frontend.</comment>
	            <validate>validate-no-empty</validate>
	        </field>
		</group>
	</section>
	<section id="video_section" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
		<label>Video</label>
		<tab>digital</tab>
		<!-- resource tag name which we have to defined in the acl.xml -->
		<resource>Digital_Homeboxes::settings</resource>
		<group id="general" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
			<label>Configuration</label>
			<field id="video_links"
                   translate="label"
                   sortOrder="4"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">
                <label>Video Links</label>
                <comment>Add video title and URL pairs. These will be displayed on the frontend.</comment>
                <!-- Points to your FieldArray renderer block -->
                <frontend_model>Digital\Homeboxes\Block\Adminhtml\Config\VideoLinks</frontend_model>
                <!-- Serializes/unserializes JSON data for DB storage -->
                <backend_model>Digital\Homeboxes\Model\Config\Backend\VideoLinksArraySerialized</backend_model>
            </field>
		</group>
	</section>
</system>
</config>