<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Product Guide</title>
        <!-- <css src="css/cms-page.css"/> -->
    </head>
    <body>
        <referenceContainer name="content">
        	<container name="div.productguide.form" htmlTag="section" htmlClass="product-guide-section section-space border-t20">
            	<block cacheable="false" class="Digital\Productguide\Block\ProductguideForm" name="productguide.form" template="Digital_Productguide::form.phtml" after="Productguide">
                    <arguments>
                        <argument name="view_model" xsi:type="object">Digital\Productguide\ViewModel\UserDataProvider</argument>
                    </arguments>
                </block>
            </container>
            <block class="Magento\Cms\Block\Block" name="product_guide_content">
                <arguments>
                    <argument name="block_id" xsi:type="string">product_guide_content</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceBlock name="breadcrumbs">
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string">Home</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="title" xsi:type="string">Home</item>
                    <item name="label" xsi:type="string">Home</item>
                    <item name="link" xsi:type="string">{{baseUrl}}</item>
                </argument>
            </action>
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string">Productguide</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="title" xsi:type="string">Productguide</item>
                    <item name="label" xsi:type="string">Productguide</item>
                </argument>
            </action>
        </referenceBlock>
    </body>
</page>
