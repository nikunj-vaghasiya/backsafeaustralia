<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ourteam_form.ourteam_form_data_source</item>
            <item name="deps" xsi:type="string">ourteam_form.ourteam_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Ourteam Information</item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">ourteam_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Digital\Ourteam\Block\Adminhtml\Edit\Button\Back"/>
            <button name="save" class="Digital\Ourteam\Block\Adminhtml\Edit\Button\Save"/>
            <button name="delete" class="Digital\Ourteam\Block\Adminhtml\Edit\Button\Delete"/>
            <button name="save_and_continue" class="Digital\Ourteam\Block\Adminhtml\Edit\Button\SaveAndContinue"/>
        </buttons>
        <namespace>ourteam_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>ourteam_form.ourteam_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="ourteam_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <!-- <validateUrl path="ourteam/team/validate"/> -->
            <submitUrl path="ourteam/team/save"/>
        </settings>
        <dataProvider class="Digital\Ourteam\Model\DataProvider" name="ourteam_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>team_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">false</item>
                <item name="label" xsi:type="string" translate="true"></item>
                <item name="sortOrder" xsi:type="number">20</item>
            </item>
        </argument>
        <field name="status" sortOrder="10" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">digital_banner</item>
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">false</rule>
                </validation>
                <dataType>boolean</dataType>
                <label translate="true">Enable</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="name">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Name</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">ourteam</item>
                    <item name="dataScope" xsi:type="string">name</item>
                    <item name="maxlength" xsi:type="number">50</item>
                    <item name="notice" xsi:type="string" translate="true">Maximum 50 characters.</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="max_text_length" xsi:type="number">50</rule>
                </validation>
            </settings>
        </field>
        <field name="designation">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Designation</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">ourteam</item>
                    <item name="dataScope" xsi:type="string">designation</item>
                    <item name="maxlength" xsi:type="number">50</item>
                    <item name="notice" xsi:type="string" translate="true">Maximum 50 characters.</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="max_text_length" xsi:type="number">50</rule>
                </validation>
            </settings>
        </field>
        <!-- <field name="description">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Description</item>
                    <item name="formElement" xsi:type="string">textarea</item>
                    <item name="source" xsi:type="string">ourteam</item>
                    <item name="dataScope" xsi:type="string">description</item>
                </item>
            </argument>
        </field> -->
        <field name="image" formElement="imageUploader">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">ourteam</item>
                    <item name="template" xsi:type="string">ui/form/element/uploader/uploader</item>
                </item>
            </argument>
            <settings>
                <elementTmpl>ui/form/element/uploader/image</elementTmpl>
                <dataType>string</dataType>
                <label translate="true">Image</label>
                <notice>Allowed image types: jpg, jpeg, png | Recommended Dimensions: W397px * H403px</notice>
                <visible>true</visible>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <required>true</required>
                        <uploaderConfig>
                            <param xsi:type="url" name="url" path="ourteam/image/upload"/>
                        </uploaderConfig>
                        <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                        <openDialogTitle>Media Gallery</openDialogTitle>
                        <initialMediaGalleryOpenSubpath>bannerslider/banner</initialMediaGalleryOpenSubpath>
                        <allowedExtensions>jpg jpeg png</allowedExtensions>
                        <maxFileSize>2097152</maxFileSize>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
        <field name="sort_order">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" translate="true" xsi:type="string">Sort Order</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">ourteam</item>
                    <item name="sortOrder" xsi:type="number">120</item>
                    <item name="dataScope" xsi:type="string">sort_order</item>
                    <item name="notice" xsi:type="string" translate="true">Please define the sort order. Lower numbers appear first. If left blank, 0 will be used.</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">false</item>
                    </item>
                </item>
            </argument>
        </field>
    </fieldset>
</form>