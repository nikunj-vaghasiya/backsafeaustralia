<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                
                <value id="hubspot-script-src-hubspot-com" type="host">*.hubspot.com</value>
                <value id="hubspot-script-src-hs-scripts" type="host">*.hs-scripts.com</value>
                <value id="hubspot-script-src-hs-analytics" type="host">*.hs-analytics.net</value>
                <value id="hubspot-script-src-hs-banner" type="host">*.hs-banner.com</value>
                <value id="hubspot-script-src-hsadspixel" type="host">*.hsadspixel.net</value>
                <value id="hubspot-script-src-hscollectedforms" type="host">*.hscollectedforms.net</value>
                <value id="hubspot-script-src-hsforms-net" type="host">*.hsforms.net</value>
                <value id="hubspot-script-src-usemessages" type="host">*.usemessages.com</value>

                
                <value id="digital-instant-one-script-src" type="host">https://instant.one</value>
                <value id="digital-js-instant-one-script-src" type="host">https://js.instant.one</value>
                <value id="digital-static-zdassets-com-script-src" type="host">https://static.zdassets.com</value>
                <value id="digital-widget-mediator-zopim-com-script-src" type="host">https://widget-mediator.zopim.com</value>
                <value id="digital-widgets-pinterest-com-script-src" type="host">https://widgets.pinterest.com</value>
                <value id="digital-static-zipmoney-com-au-script-src" type="host">https://static.zipmoney.com.au</value>
                <value id="digital-addthis.com-script-src" type="host">addthis.com</value>
                <value id="digital-s7-addthis-com-script-src" type="host">http://s7.addthis.com</value>
                <value id="digital-v1-addthisedge-com-script-src" type="host">https://v1.addthisedge.com</value>
                <value id="digital-m-addthis-com-script-src" type="host">https://m.addthis.com</value>
                <value id="digital-z-moatads-com-script-src" type="host">https://z.moatads.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                
                <value id="hubspot-connect-src-hubspot-com" type="host">*.hubspot.com</value>
                <value id="hubspot-connect-src-hubapi" type="host">*.hubapi.com</value>
                <value id="hubspot-connect-src-hsforms-com" type="host">*.hsforms.com</value>
                <value id="hubspot-connect-src-hscollectedforms" type="host">*.hscollectedforms.net</value>

                
                <value id="digital-api-instant-one-connect-src" type="host">https://api.instant.one</value>
                <value id="apptrian-checkout-instant-one-connect-src" type="host">https://instant.one</value>
                <value id="digital-ekr-zdassets-com-connect-src" type="host">https://ekr.zdassets.com</value>
                <value id="digital-widget-mediator-zopim-com-connect-src" type="host">wss://widget-mediator.zopim.com</value>                
                <value id="digital-api-sandbox-zipmoney-com-au-connect-src" type="host">https://api.sandbox.zipmoney.com.au</value>
                <value id="digital-t.labs.au.edge.zip.co-connect-src" type="host">https://t.labs.au.edge.zip.co</value>
                <value id="digital-addthis.com-connect-src" type="host">addthis.com</value>
                <value id="digital-api-public-addthis-com-connect-src" type="host">https://api-public.addthis.com</value>
                <value id="digital-baygallery-zendesk-com-connect-src" type="host">https://baygallery.zendesk.com</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                
                <value id="hubspot-frame-src-hubspot-com" type="host">*.hubspot.com</value>

                
                <value id="digital-www-google-com-frame-src" type="host">https://www.google.com</value>
                
                <value id="digital-s7-addthis-com-frame-src" type="host">https://s7.addthis.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <!-- HubSpot -->
                <value id="hubspot-img-src-hubspot-com" type="host">*.hubspot.com</value>
                <value id="hubspot-img-src-hsforms-com" type="host">*.hsforms.com</value>

                <!-- Existing (kept) -->
                <value id="digital-static-zipmoney-com-au-img-src" type="host">https://static.zipmoney.com.au</value>
            </values>
        </policy>
        <policy id="media-src">
            <values>
                <value id="digital-static-zdassets-com-media-src" type="host">https://static.zdassets.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
