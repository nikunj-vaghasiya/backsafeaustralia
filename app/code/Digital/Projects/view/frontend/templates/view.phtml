<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('projectNav', () => ({
        active: null,

        init() {
            this.updateOnScroll();

            window.addEventListener('scroll', () => {
                this.updateOnScroll();
            });
        },

        updateOnScroll() {
            const sections = ['timePeriod', 'challenge', 'challengeGallery', 'solution', 'gallery', 'outcome'];

            for (let id of sections) {
                const el = document.getElementById(id);
                if (!el) continue;

                const rect = el.getBoundingClientRect();

                if (rect.top <= 150 && rect.bottom > 150) {
                    this.active = id;
                    return;
                }
            }
        },

        setActive(id) {
            this.active = id;
        }
    }))
})
</script>
<script>
    'use strict';
    function initProjectsCarousel() {
        return {
            ...window.carouselHandler,
            active: 0,
            itemCount: 0,
            pageSize: 2,
            pageFillers: 0,
            autoPlay: true,
            sliderRef: 'popularCategoryCarouselSection',
        }
    }
</script>