<script>
    require([
        "jquery",
        "Magento_Ui/js/modal/modal"
    ], function($, modal) {
        var options = {
            type: 'popup',
            responsive: true,
            innerScroll: true,
            buttons: [],
            opened: function () {
                $('.modal-popup').addClass('projects-video-modal');
            },
            closed: function () {
                $('.modal-popup').removeClass('projects-video-modal');
            }
        };

        var popup = $('#projects-video');
        
        modal(options, popup);

        $(".video-preview").click(function() {
            popup.modal('openModal');

            var video = $("#video-player")[0];
            video.play();
        });

        popup.on('modalclosed', function() {
            var video = $("#video-player")[0];
            video.pause();
            video.currentTime = 0;
        });
    });
</script>
