         <argument name="data" xsi:type="array">

            <item name="config" xsi:type="array">

                <item name="collapsible" xsi:type="boolean">false</item>

                <item name="label" xsi:type="string" translate="true">Assign Products</item>

                <item name="sortOrder" xsi:type="number">160</item>

            </item>

        </argument>



        <container name="assign_products_container">

            <argument name="data" xsi:type="array">

                <item name="config" xsi:type="array">

                    <item name="sortOrder" xsi:type="number">161</item>

                </item>

            </argument>

            <htmlContent name="html_content">

                <argument name="block" xsi:type="object">Digital\Projects\Block\Adminhtml\Projects\AssignProducts</argument>

            </htmlContent>

        </container>

    </fieldset> -->

</form>

