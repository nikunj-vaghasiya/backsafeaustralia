<?php
/** @var \Hubspot\ProductEnquiry\Block\Adminhtml\Enquiry\View $block */
$enquiry = $block->getEnquiry();
$rows = [];
if ($enquiry) {
    $rows = [
        (string) __('Name')         => $enquiry->getName(),
        (string) __('Email')        => $enquiry->getEmail(),
        (string) __('Phone')        => $enquiry->getPhone(),
        (string) __('Enquiry')      => $enquiry->getEnquiry(),
        (string) __('Comments')     => $enquiry->getComments(),
        (string) __('Submitted On') => $enquiry->getCreatedAt(),
    ];
}
?>
<div class="admin__page-section" style="margin-top:10px;">
    <div class="page-actions" style="text-align:right;margin-bottom:15px;">
        <button type="button" class="action-default scalable back"
                onclick="window.location.href='<?= $block->escapeUrl($block->getBackUrl()) ?>';">
            <span><?= $block->escapeHtml(__('Back')) ?></span>
        </button>
        <?php if ($enquiry && $enquiry->getId()): ?>
            <button type="button" class="action-default scalable delete"
                    onclick="if(confirm('<?= $block->escapeJs(__('Are you sure you want to delete this enquiry?')) ?>')){window.location.href='<?= $block->escapeUrl($block->getDeleteUrl()) ?>';}">
                <span><?= $block->escapeHtml(__('Delete')) ?></span>
            </button>
        <?php endif; ?>
    </div>

    <div class="admin__page-section-title">
        <span class="title"><?= $block->escapeHtml(__('Product Enquiry')) ?></span>
    </div>

    <?php if ($enquiry && $enquiry->getId()): ?>
        <table class="admin__table-secondary" style="width:100%;">
            <?php foreach ($rows as $label => $value): ?>
                <tr>
                    <th style="width:220px;text-align:left;vertical-align:top;padding:10px;"><?= $block->escapeHtml($label) ?></th>
                    <td style="padding:10px;">
                        <?php if ($value !== null && $value !== ''): ?>
                            <?= nl2br($block->escapeHtml($value)) ?>
                        <?php else: ?>
                            &mdash;
                        <?php endif; ?>
                    </td>
                </tr>
            <?php endforeach; ?>
        </table>

        <?php $raw = $enquiry->getRawData(); ?>
        <?php if ($raw): ?>
            <details style="margin-top:20px;">
                <summary style="cursor:pointer;font-weight:600;"><?= $block->escapeHtml(__('Full payload (raw data)')) ?></summary>
                <pre style="white-space:pre-wrap;background:#f7f7f7;padding:12px;border-radius:4px;margin-top:8px;"><?= $block->escapeHtml($raw) ?></pre>
            </details>
        <?php endif; ?>
    <?php else: ?>
        <p><?= $block->escapeHtml(__('Enquiry not found.')) ?></p>
    <?php endif; ?>
</div>
